{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "ESNext"],
    "allowJs": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"],
      "@api/*": ["./src/renderer/api/*"],
      "@components/*": ["./src/renderer/components/*"]
    },
    "jsx": "react-jsx",
    "types": ["node"],
    "rootDir": "./"
  },
  "include": [
    "src/**/*",
    "webpack.main.config.ts",
    "webpack.renderer.config.ts"
  ]
}
